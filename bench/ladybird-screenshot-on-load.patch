+// Paints the viewport fresh in WebContent, so it reflects the current document state rather than the last displayed frame.
+NonnullRefPtr<Core::Promise<LexicalPath>> ViewImplementation::take_viewport_screenshot()
+{
+    if (m_pending_screenshot)
+        return Core::Promise<LexicalPath>::rejected(Error::from_string_literal("A screenshot request is already in progress"));
+
+    auto promise = Core::Promise<LexicalPath>::construct();
+    m_pending_screenshot = promise;
+    page().async_take_viewport_screenshot();
+    return promise;
+}
