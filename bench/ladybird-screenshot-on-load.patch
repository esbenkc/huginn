+static void load_page_for_viewport_screenshot_on_load_and_exit(Core::EventLoop& event_loop, HeadlessWebView& view, URL::URL const& url)
+{
+    view.on_load_finish = [&view, &event_loop, requested = false](URL::URL const& loaded_url) mutable {
+        // Ignore the initial about:blank, and any load that finishes after the screenshot was requested.
+        if (requested || loaded_url.scheme() == "about"sv)
+            return;
+        requested = true;
+        view.take_viewport_screenshot()
+            ->when_resolved([&event_loop](auto const& path) {
+                outln("Saved screenshot to: {}", path);
+                event_loop.quit(0);
+            })
+            .when_rejected([&event_loop](auto const& error) {
+                warnln("Unable to take screenshot: {}", error);
+                event_loop.quit(1);
+            });
+    };
+
+    view.load(url);
+}
